global:
  resolve_timeout: 5m

templates: []

route:
  group_by:
    - alertname
    - host
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
  receiver: aicorp-webhook

receivers:
  - name: aicorp-webhook
    webhook_configs:
      - url: '__ALERTMANAGER_WEBHOOK_URL__'
        send_resolved: true

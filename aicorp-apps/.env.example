# Copy the required values into the Admin VM's protected external environment.
# Do not commit the populated file or place real credentials in this file.
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql://aicorp:replace-me@postgres:5432/aicorp
LITELLM_MASTER_KEY=replace-me
OPENAI_API_KEY=replace-me
ALERTMANAGER_WEBHOOK_URL=https://example.invalid/aicorp-alerts
OLLAMA_BASE_URL=http://desktop-host.example:11434
EMBEDDING_MODEL=nomic-embed-text
KNOWLEDGE_COLLECTION=aicorp-knowledge
AGENT_NAME=aicorp-health-summary
AGENT_MODEL=gpt-4o-mini
PRODUCT_MANAGER_NAME=aicorp-product-manager
PRODUCT_MANAGER_MODEL=gpt-4o-mini
CTO_NAME=aicorp-cto
CTO_MODEL=gpt-4o-mini
ENGINEERING_MANAGER_NAME=aicorp-engineering-manager
ENGINEERING_MANAGER_MODEL=gpt-4o-mini
SOFTWARE_ENGINEER_NAME=aicorp-software-engineer
QA_ENGINEER_NAME=aicorp-qa-engineer
WORKER_MODEL=gpt-4o-mini
AGENT_INTERVAL_SECONDS=3600
AGENT_HTTP_PORT=8081
AGENT_APPROVAL_TOKEN=replace-with-a-long-random-approval-token
AICORP_OPERATOR_NAME=andrew
PRODUCT_MANAGER_APPROVAL_TOKEN=replace-with-a-separate-product-manager-token
CTO_APPROVAL_TOKEN=replace-with-a-separate-cto-token
ENGINEERING_MANAGER_APPROVAL_TOKEN=replace-with-a-separate-engineering-manager-token
SOFTWARE_ENGINEER_APPROVAL_TOKEN=
QA_ENGINEER_APPROVAL_TOKEN=
AGENT_APPROVAL_TTL_SECONDS=86400
